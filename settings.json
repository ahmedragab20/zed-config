{
    "calls": {
        "mute_on_join": false,
    },
    "close_on_file_delete": true,
    "helix_mode": false,
    "selection_highlight": true,
    "rounded_selection": false,
    "buffer_line_height": {
        "custom": 1.35,
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always",
                    },
                },
            },
            "enable_lsp_tasks": true,
        },
    },
    "prettier": {
        "allowed": true,
    },
    "redact_private_values": false,
    "auto_signature_help": false,
    "auto_indent": true,
    "minimap": {
        "max_width_columns": 70,
    },
    "show_signature_help_after_edits": false,
    "inlay_hints": {
        "enabled": false,
    },
    "soft_wrap": "none",
    "hard_tabs": false,
    "active_pane_modifiers": {
        "inactive_opacity": 1.0,
    },
    "centered_layout": {
        "left_padding": 0.19999980926513672,
    },
    "bottom_dock_layout": "contained",
    "preview_tabs": {
        "enabled": true,
    },
    "title_bar": {
        "show_branch_icon": false,
        "show_menus": false,
        "show_sign_in": true,
        "show_user_picture": true,
        "show_onboarding_banner": false,
        "show_project_items": true,
        "show_branch_name": true,
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
        },
        "button": true,
    },
    "status_bar": {
        "active_encoding_button": "non_utf8",
        "cursor_position_button": true,
        "active_language_button": true,
    },
    "file_finder": {
        "file_icons": true,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "auto_update": false,
    "edit_predictions": {
        "mode": "subtle",
        "enabled_in_text_threads": false,
    },
    "tabs": {
        "file_icons": false,
        "git_status": false,
    },
    "tab_size": 4,
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false,
        "show": false,
    },
    "toolbar": {
        "agent_review": true,
        "breadcrumbs": true,
        "quick_actions": false,
        "selections_menu": false,
        "code_actions": false,
    },
    "cursor_blink": false,
    "vertical_scroll_margin": 4,
    "max_tabs": 5,
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "on_yank",
        "use_smartcase_find": true,
        "highlight_on_yank_duration": 200,
    },
    "command_aliases": {
        "W": "w",
        "Wq": "wq",
        "Q": "q",
        "Qa": "qa",
        "Qwa": "qwa",
        "QWa": "qwa",
    },
    "relative_line_numbers": "enabled",
    "hide_mouse": "on_typing_and_movement",
    "current_line_highlight": "gutter",
    "scrollbar": {
        "axes": {
            "vertical": false,
            "horizontal": false,
        },
        "show": "never",
    },
    "gutter": {
        "line_numbers": true,
        "runnables": true,
        "breakpoints": true,
        "folds": true,
        "min_line_number_digits": 0,
    },
    "indent_guides": {
        "enabled": true,
        "line_width": 0,
        "active_line_width": 2,
        "coloring": "indent_aware",
        "background_coloring": "disabled",
    },
    "git": {
        "branch_picker": {
            "show_author_name": true,
        },
        "blame": {
            "show_avatar": true,
        },
        "inline_blame": {
            "enabled": true,
            "min_column": 0,
            "show_commit_summary": false,
        },
        "hunk_style": "unstaged_hollow",
    },
    "project_panel": {
        "git_status": true,
        "hide_root": true,
        "auto_fold_dirs": true,
        "starts_open": false,
        "file_icons": true,
        "entry_spacing": "standard",
        "dock": "right",
        "scrollbar": null,
        "button": false,
        "sticky_scroll": false,
        "folder_icons": false,
        "default_width": 400.0,
        "show_diagnostics": "errors",
    },
    "debugger": {
        "save_breakpoints": true,
        "button": false,
    },
    "collaboration_panel": {
        "button": false,
    },
    "search": {
        "center_on_match": true,
        "button": false,
    },
    "git_panel": {
        "button": false,
    },
    "outline_panel": {
        "file_icons": true,
        "button": false,
    },
    "notification_panel": {
        "button": false,
    },
    "terminal": {
        "scrollbar": {
            "show": "never",
        },
        "toolbar": {
            "breadcrumbs": false,
        },
        "button": false,
    },
    "agent": {
        "play_sound_when_agent_done": true,
        "inline_assistant_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5",
        },
        "default_profile": "write",
        "always_allow_tool_actions": true,
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5",
        },
        "model_parameters": [],
    },
    "features": {
        "edit_prediction_provider": "zed",
    },
    "ui_font_size": 30,
    "buffer_font_size": 33,
    "buffer_font_family": "DankMono Nerd Font Mono",
    "ui_font_family": "DankMono Nerd Font Mono",
    "theme": "Nordic Syntax",
    "icon_theme": "Zed (Default)",
    "use_smartcase_search": false,
    "seed_search_query_from_cursor": "selection",
    "show_completion_documentation": true,
    "always_treat_brackets_as_autoclosed": true,
    "experimental.theme_overrides": {
        "vim.normal.background": "#4C566A",
        "vim.insert.background": "#2E8B57",
        "vim.visual.background": "#5E81AC",
        "vim.replace.background": "#BF616A",
        "vim.visual_line.background": "#81A1C1",
        "vim.visual_block.background": "#8FBCBB",
        "vim.helix_select.background": "#B48EAD",
        "vim.helix_normal.background": "#434C5E",
        "editor.active_line.background": "#D08770",
        "editor.active_line_number": "#f4f7f7",
        "players": [
            {
                "cursor": "#D08770",
                "background": "#9a523b",
                "selection": "#9a523b",
            },
        ],
    },
}
